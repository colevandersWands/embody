{
  "name": "@study-lenses/embody",
  "version": "1.0.0",
  "description": "Give life to JavaScript code through execution tracing. Sister library to @study-lenses/examine for static analysis.",
  "type": "module",
  "workspaces": [
    "src/tracers/js-klve"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./config": {
      "import": "./dist/configuring/create.js",
      "types": "./dist/configuring/create.d.ts"
    },
    "./core/events": {
      "import": "./dist/core/events.js",
      "types": "./dist/core/events.d.ts"
    },
    "./core/state": {
      "import": "./dist/core/state.js",
      "types": "./dist/core/state.d.ts"
    },
    "./advice": {
      "import": "./dist/advice/index.js",
      "types": "./dist/advice/index.d.ts"
    },
    "./utils/serializer": {
      "import": "./dist/utils/serializer.js",
      "types": "./dist/utils/serializer.d.ts"
    },
    "./browser": {
      "import": "./dist/embody.browser.js"
    }
  },
  "scripts": {
    "build": "tsc && npm run build:copy-json",
    "build:watch": "tsc --watch",
    "build:bundle": "esbuild src/index.ts --bundle --format=esm --outfile=dist/embody.browser.js",
    "build:copy-json": "mkdir -p dist/tracers/chars dist/tracers/js-klve && cp src/tracers/meta.schema.json dist/tracers/ && cp src/tracers/chars/options.schema.json dist/tracers/chars/ && cp src/tracers/js-klve/options.schema.json dist/tracers/js-klve/",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "dev:sandbox": "esbuild src/index.ts --bundle --format=esm --outfile=dist/embody.browser.js --servedir=. --serve=8080",
    "test": "jest",
    "test:types": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm run build:bundle",
    "prepare": "husky",
    "validate": "npm run lint && npm run type-check && npm test -- --watchAll=false"
  },
  "keywords": [
    "embody",
    "examine",
    "study-lenses",
    "javascript",
    "tracer",
    "execution",
    "instrumentation",
    "aran",
    "debugging",
    "functional",
    "typescript",
    "dynamic-analysis",
    "educational"
  ],
  "author": "Study Lenses Project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/colevandersWands/embody.git"
  },
  "bugs": {
    "url": "https://github.com/colevandersWands/embody/issues"
  },
  "homepage": "https://github.com/colevandersWands/embody#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "babel-jest": "^30.2.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-functional": "^9.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.6",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "ts-api-utils": "^2.4.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.53.1"
  },
  "peerDependencies": {
    "aran": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "aran": {
      "optional": false
    }
  },
  "dependencies": {
    "ajv": "^7.2.4"
  },
  "optionalDependencies": {
    "source-map-support": "^0.5.21"
  },
  "browserslist": [
    "node >= 22"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
